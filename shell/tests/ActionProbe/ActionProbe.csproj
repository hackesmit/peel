<Project Sdk="Microsoft.NET.Sdk">

  <!-- A tiny driver that runs one Alt wheel action in the logged on desktop
       session and reports what it did, so the scripted check on George can
       verify Copy, Move and Terminal and screenshot Float and Share. It is not
       part of the app: run-actions.ps1 builds and launches it. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <AssemblyName>Peel.ActionProbe</AssemblyName>
    <RootNamespace>Peel.ActionProbe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Peel\Peel.csproj" />
  </ItemGroup>

</Project>
