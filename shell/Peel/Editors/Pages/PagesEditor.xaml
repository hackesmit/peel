<editors:EditorWindowBase x:Class="Peel.Editors.Pages.PagesEditor"
                          x:ClassModifier="internal"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:editors="clr-namespace:Peel.Editors"
                          Title="Pages"
                          Background="{DynamicResource EditorBack}"
                          SizeToContent="WidthAndHeight"
                          ResizeMode="NoResize"
                          FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary Source="/Peel;component/Editors/EditorStyles.xaml" />
    </Window.Resources>
    <StackPanel Margin="14">
        <DockPanel Margin="0,0,0,10">
            <TextBlock x:Name="Heading" Style="{StaticResource EditorTitle}" Text="Pages" DockPanel.Dock="Left" />
            <TextBlock x:Name="Subject" Style="{StaticResource EditorText}" Margin="10,0,0,0"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Border Background="{StaticResource EditorCanvas}" BorderBrush="{StaticResource EditorEdge}"
                BorderThickness="1">
            <ScrollViewer x:Name="Scroller" Width="780" Height="470"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="Sheet" Background="Transparent">
                    <WrapPanel x:Name="Cards" Margin="8" />
                    <Canvas x:Name="Marks" IsHitTestVisible="False" />
                </Grid>
            </ScrollViewer>
        </Border>

        <WrapPanel x:Name="Tools" Margin="0,10,0,0" />

        <WrapPanel x:Name="RangePanel" Margin="0,8,0,0" Visibility="Collapsed">
            <TextBlock x:Name="RangeLabel" Style="{StaticResource EditorLabel}" Text="Page ranges" />
            <TextBox x:Name="RangeField" Style="{StaticResource EditorField}" Width="300"
                     AutomationProperties.AutomationId="PagesRanges" AutomationProperties.Name="Page ranges" />
        </WrapPanel>

        <DockPanel Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Style="{StaticResource EditorButton}" Content="Cancel"
                        AutomationProperties.AutomationId="PagesCancel" Click="OnCancel" />
                <Button x:Name="ApplyButton" Style="{StaticResource EditorPrimary}" Content="Save"
                        AutomationProperties.AutomationId="PagesApply" Click="OnApply" />
            </StackPanel>
            <TextBlock x:Name="Hint" Style="{StaticResource EditorText}" TextWrapping="Wrap" MaxWidth="560"
                       HorizontalAlignment="Left" AutomationProperties.AutomationId="PagesHint" />
        </DockPanel>
    </StackPanel>
</editors:EditorWindowBase>
