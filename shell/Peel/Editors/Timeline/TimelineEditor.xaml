<editors:EditorWindowBase x:Class="Peel.Editors.Timeline.TimelineEditor"
                          x:ClassModifier="internal"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:editors="clr-namespace:Peel.Editors"
                          Title="Timeline"
                          Background="{DynamicResource EditorBack}"
                          SizeToContent="WidthAndHeight"
                          ResizeMode="NoResize"
                          FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary Source="/Peel;component/Editors/EditorStyles.xaml" />
    </Window.Resources>
    <StackPanel Margin="14">
        <DockPanel Margin="0,0,0,10">
            <TextBlock x:Name="Heading" Style="{StaticResource EditorTitle}" Text="Timeline" DockPanel.Dock="Left" />
            <TextBlock x:Name="Subject" Style="{StaticResource EditorText}" Margin="10,0,0,0"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Border Background="{StaticResource EditorCanvas}" BorderBrush="{StaticResource EditorEdge}"
                BorderThickness="1" HorizontalAlignment="Center">
            <Grid x:Name="Stage" ClipToBounds="True">
                <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close"
                              ScrubbingEnabled="True" Stretch="Uniform" Volume="0.8"
                              Visibility="Collapsed" />
                <Image x:Name="Still" Stretch="Uniform" />
                <TextBlock x:Name="StageNote" Style="{StaticResource EditorText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="20,0"
                           AutomationProperties.AutomationId="TimelineStageNote" />
                <Canvas x:Name="Overlay" Background="Transparent" Visibility="Collapsed"
                        AutomationProperties.AutomationId="TimelineCanvas"
                        AutomationProperties.Name="Frame" />
            </Grid>
        </Border>

        <Border x:Name="BarHost" Margin="0,10,0,0" BorderBrush="{StaticResource EditorEdge}"
                BorderThickness="1" HorizontalAlignment="Center" />

        <WrapPanel Margin="0,8,0,0">
            <Button x:Name="PlayButton" Style="{StaticResource EditorButton}" Content="Play"
                    AutomationProperties.AutomationId="TimelinePlay" Click="OnPlay" />
            <TextBlock x:Name="PlayheadText" Style="{StaticResource EditorText}" Margin="4,0,14,0"
                       MinWidth="150" AutomationProperties.AutomationId="TimelinePlayhead" />
            <WrapPanel x:Name="MarkPanel" />
        </WrapPanel>

        <WrapPanel x:Name="FieldPanel" Margin="0,8,0,0" />
        <WrapPanel x:Name="RegionPanel" Margin="0,8,0,0" Visibility="Collapsed" />
        <WrapPanel x:Name="QualityPanel" Margin="0,8,0,0" Visibility="Collapsed" />

        <DockPanel Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Style="{StaticResource EditorButton}" Content="Cancel"
                        AutomationProperties.AutomationId="TimelineCancel" Click="OnCancel" />
                <Button x:Name="ApplyButton" Style="{StaticResource EditorPrimary}" Content="Apply"
                        AutomationProperties.AutomationId="TimelineApply" Click="OnApply" />
            </StackPanel>
            <TextBlock x:Name="Hint" Style="{StaticResource EditorText}" TextWrapping="Wrap" MaxWidth="560"
                       HorizontalAlignment="Left"
                       AutomationProperties.AutomationId="TimelineHint" />
        </DockPanel>
    </StackPanel>
</editors:EditorWindowBase>
