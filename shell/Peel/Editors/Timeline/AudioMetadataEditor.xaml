<editors:EditorWindowBase x:Class="Peel.Editors.Timeline.AudioMetadataEditor"
                          x:ClassModifier="internal"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:editors="clr-namespace:Peel.Editors"
                          Title="Metadata"
                          Background="{DynamicResource EditorBack}"
                          Width="520"
                          SizeToContent="Height"
                          ResizeMode="NoResize"
                          FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary Source="/Peel;component/Editors/EditorStyles.xaml" />
    </Window.Resources>
    <StackPanel Margin="14">
        <DockPanel Margin="0,0,0,10">
            <TextBlock Style="{StaticResource EditorTitle}" Text="Metadata" DockPanel.Dock="Left" />
            <TextBlock x:Name="Subject" Style="{StaticResource EditorText}" Margin="10,0,0,0"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- One row per field the engine declares, built in code from the
             schema, so a field added to av.audio_metadata appears here. -->
        <Grid x:Name="Form">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        </Grid>

        <TextBlock x:Name="Problem" Style="{StaticResource EditorText}" Margin="0,8,0,0"
                   Foreground="{StaticResource EditorWarn}" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="AudioMetaProblem" />

        <DockPanel Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Style="{StaticResource EditorButton}" Content="Cancel"
                        AutomationProperties.AutomationId="AudioMetaCancel" Click="OnCancel" />
                <Button Style="{StaticResource EditorPrimary}" Content="Save"
                        AutomationProperties.AutomationId="AudioMetaApply" Click="OnApply" />
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="Hint" Style="{StaticResource EditorText}" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="Enter saves, Escape cancels. Peel writes a new file and never changes this one. The sound is copied, not encoded again." />
    </StackPanel>
</editors:EditorWindowBase>
