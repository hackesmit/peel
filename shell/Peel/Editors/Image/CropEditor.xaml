<editors:EditorWindowBase x:Class="Peel.Editors.Image.CropEditor"
                          x:ClassModifier="internal"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:editors="clr-namespace:Peel.Editors"
                          Title="Crop"
                          Background="{DynamicResource EditorBack}"
                          SizeToContent="WidthAndHeight"
                          ResizeMode="NoResize"
                          FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary Source="/Peel;component/Editors/EditorStyles.xaml" />
    </Window.Resources>
    <StackPanel Margin="14">
        <DockPanel Margin="0,0,0,10">
            <TextBlock Style="{StaticResource EditorTitle}" Text="Crop" DockPanel.Dock="Left" />
            <TextBlock x:Name="Subject" Style="{StaticResource EditorText}" Margin="10,0,0,0"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Border Background="{StaticResource EditorCanvas}" BorderBrush="{StaticResource EditorEdge}"
                BorderThickness="1" Padding="0" HorizontalAlignment="Center">
            <Grid x:Name="Stage" ClipToBounds="True">
                <Image x:Name="Picture" Stretch="Fill" />
                <Canvas x:Name="Overlay" Background="Transparent"
                        AutomationProperties.AutomationId="CropCanvas"
                        AutomationProperties.Name="Crop area" />
            </Grid>
        </Border>

        <WrapPanel x:Name="AspectPanel" Margin="0,10,0,0" />

        <WrapPanel Margin="0,8,0,0">
            <TextBlock Style="{StaticResource EditorLabel}" x:Name="LabelX" Text="Left" />
            <TextBox x:Name="FieldX" Style="{StaticResource EditorField}" Margin="0,0,10,0"
                     AutomationProperties.AutomationId="CropX" AutomationProperties.Name="Left" />
            <TextBlock Style="{StaticResource EditorLabel}" x:Name="LabelY" Text="Top" />
            <TextBox x:Name="FieldY" Style="{StaticResource EditorField}" Margin="0,0,10,0"
                     AutomationProperties.AutomationId="CropY" AutomationProperties.Name="Top" />
            <TextBlock Style="{StaticResource EditorLabel}" x:Name="LabelW" Text="Width" />
            <TextBox x:Name="FieldW" Style="{StaticResource EditorField}" Margin="0,0,10,0"
                     AutomationProperties.AutomationId="CropW" AutomationProperties.Name="Width" />
            <TextBlock Style="{StaticResource EditorLabel}" x:Name="LabelH" Text="Height" />
            <TextBox x:Name="FieldH" Style="{StaticResource EditorField}" Margin="0,0,10,0"
                     AutomationProperties.AutomationId="CropH" AutomationProperties.Name="Height" />
            <Button x:Name="ResetButton" Style="{StaticResource EditorButton}" Content="Whole image"
                    MinWidth="88" AutomationProperties.AutomationId="CropReset" Click="OnReset" />
        </WrapPanel>

        <DockPanel Margin="0,12,0,0">
            <TextBlock x:Name="Hint" Style="{StaticResource EditorText}" DockPanel.Dock="Left"
                       AutomationProperties.AutomationId="CropHint"
                       Text="Drag a corner or type the numbers. Enter crops, Escape cancels." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Style="{StaticResource EditorButton}" Content="Cancel"
                        AutomationProperties.AutomationId="CropCancel" Click="OnCancel" />
                <Button x:Name="ApplyButton" Style="{StaticResource EditorPrimary}" Content="Crop"
                        AutomationProperties.AutomationId="CropApply" Click="OnApply" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</editors:EditorWindowBase>
