<editors:EditorWindowBase x:Class="Peel.Editors.Image.MetadataEditor"
                          x:ClassModifier="internal"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:editors="clr-namespace:Peel.Editors"
                          Title="Metadata"
                          Background="{DynamicResource EditorBack}"
                          SizeToContent="Height"
                          Width="560"
                          ResizeMode="NoResize"
                          FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary Source="/Peel;component/Editors/EditorStyles.xaml" />
    </Window.Resources>
    <StackPanel Margin="14">
        <DockPanel Margin="0,0,0,10">
            <TextBlock Style="{StaticResource EditorTitle}" Text="Metadata" DockPanel.Dock="Left" />
            <TextBlock x:Name="Subject" Style="{StaticResource EditorText}" Margin="10,0,0,0"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" x:Name="LabelTitle" Style="{StaticResource EditorLabel}"
                       Text="Title" Margin="0,4,8,4" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="FieldTitle" Style="{StaticResource EditorField}"
                     Margin="0,4,0,4" AutomationProperties.AutomationId="MetaTitle"
                     AutomationProperties.Name="Title" />

            <TextBlock Grid.Row="1" Grid.Column="0" x:Name="LabelAuthor" Style="{StaticResource EditorLabel}"
                       Text="Author" Margin="0,4,8,4" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="FieldAuthor" Style="{StaticResource EditorField}"
                     Margin="0,4,0,4" AutomationProperties.AutomationId="MetaAuthor"
                     AutomationProperties.Name="Author" />

            <TextBlock Grid.Row="2" Grid.Column="0" x:Name="LabelLatitude" Style="{StaticResource EditorLabel}"
                       Text="Latitude" Margin="0,4,8,4" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="FieldLatitude" Style="{StaticResource EditorField}"
                     Margin="0,4,0,4" HorizontalAlignment="Left" MinWidth="140"
                     AutomationProperties.AutomationId="MetaLatitude"
                     AutomationProperties.Name="Latitude" />

            <TextBlock Grid.Row="3" Grid.Column="0" x:Name="LabelLongitude" Style="{StaticResource EditorLabel}"
                       Text="Longitude" Margin="0,4,8,4" />
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="FieldLongitude" Style="{StaticResource EditorField}"
                     Margin="0,4,0,4" HorizontalAlignment="Left" MinWidth="140"
                     AutomationProperties.AutomationId="MetaLongitude"
                     AutomationProperties.Name="Longitude" />
        </Grid>

        <TextBlock Style="{StaticResource EditorLabel}" Margin="0,12,0,4" Text="Tags in the file" />
        <Border Background="{StaticResource EditorCanvas}" BorderBrush="{StaticResource EditorEdge}"
                BorderThickness="1" Height="150">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,6">
                <!-- Two columns of plain text, filled in code: there is
                     nothing here for a template or a binding to do. -->
                <StackPanel x:Name="TagList" />
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="Problem" Style="{StaticResource EditorText}" Margin="0,8,0,0"
                   Foreground="{StaticResource EditorWarn}" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="MetaProblem" />

        <DockPanel Margin="0,10,0,0">
            <Button Style="{StaticResource EditorButton}" Content="Remove all tags" MinWidth="120"
                    DockPanel.Dock="Left" AutomationProperties.AutomationId="MetaStrip" Click="OnStrip" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Style="{StaticResource EditorButton}" Content="Cancel"
                        AutomationProperties.AutomationId="MetaCancel" Click="OnCancel" />
                <Button Style="{StaticResource EditorPrimary}" Content="Save"
                        AutomationProperties.AutomationId="MetaApply" Click="OnApply" />
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="Hint" Style="{StaticResource EditorText}" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="Enter saves, Escape cancels. Peel writes a new file and never changes this one." />
    </StackPanel>
</editors:EditorWindowBase>
