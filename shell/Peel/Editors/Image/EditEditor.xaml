<editors:EditorWindowBase x:Class="Peel.Editors.Image.EditEditor"
                          x:ClassModifier="internal"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:editors="clr-namespace:Peel.Editors"
                          Title="Edit"
                          Background="{DynamicResource EditorBack}"
                          SizeToContent="WidthAndHeight"
                          ResizeMode="NoResize"
                          FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary Source="/Peel;component/Editors/EditorStyles.xaml" />
    </Window.Resources>
    <StackPanel Margin="14">
        <DockPanel Margin="0,0,0,10">
            <TextBlock Style="{StaticResource EditorTitle}" Text="Edit" DockPanel.Dock="Left" />
            <TextBlock x:Name="Subject" Style="{StaticResource EditorText}" Margin="10,0,0,0"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Border Background="{StaticResource EditorCanvas}" BorderBrush="{StaticResource EditorEdge}"
                BorderThickness="1" HorizontalAlignment="Center" Padding="8">
            <Grid x:Name="Stage">
                <Image x:Name="Picture" Stretch="Fill"
                       AutomationProperties.AutomationId="EditPreview"
                       AutomationProperties.Name="Preview" />
            </Grid>
        </Border>

        <WrapPanel x:Name="RotatePanel" Margin="0,10,0,0" />
        <WrapPanel x:Name="FlipPanel" Margin="0,6,0,0" />

        <Grid x:Name="Sliders" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
        </Grid>

        <DockPanel Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button x:Name="ResetButton" Style="{StaticResource EditorButton}" Content="Reset"
                        AutomationProperties.AutomationId="EditReset" Click="OnReset" />
                <TextBlock x:Name="Hint" Style="{StaticResource EditorText}"
                           AutomationProperties.AutomationId="EditHint"
                           Text="Enter saves, Escape cancels." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Style="{StaticResource EditorButton}" Content="Cancel"
                        AutomationProperties.AutomationId="EditCancel" Click="OnCancel" />
                <Button Style="{StaticResource EditorPrimary}" Content="Save"
                        AutomationProperties.AutomationId="EditApply" Click="OnApply" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</editors:EditorWindowBase>
